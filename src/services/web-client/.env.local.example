# =============================================================================
# Web client — local overrides (copy to .env.local)
# =============================================================================
#
# BETA / DOCKER — READ THIS FIRST
# -------------------------------
# Your browser runs on YOUR machine, not inside Docker. Any variable prefixed
# with NEXT_PUBLIC_ is baked into client JavaScript and used by the browser.
#
# NEVER set NEXT_PUBLIC_* to Docker-only hostnames (they are not DNS-resolvable
# on your laptop and cause net::ERR_NAME_NOT_RESOLVED), for example:
#   - http://mas:8000
#   - http://rabbitmq:5672
#   - http://postgres:5432
#   - any Compose service name as hostname
#
# MAS REST from the browser always uses the same-origin path /api/orchestrator
# (Next rewrites to MAS). The client does not read NEXT_PUBLIC_API_URL for that,
# so a bad value like http://mas:8000 can never be baked into fetch() again.
# =============================================================================

# Server-side only: where Next.js forwards /api/orchestrator/*. Used when you
# run `next dev` on the host; in Docker, Compose usually sets this to
# http://mas:8000. Do not rely on this variable for browser fetch() — it is
# not exposed to the client by default.
ORCHESTRATOR_URL=

# Unused for MAS REST (hard-coded /api/orchestrator). Kept for compatibility;
# leave empty.
NEXT_PUBLIC_API_URL=

# Browser-reachable knowledge store (e.g. published host port). Do not use a
# Docker-internal hostname unless you know the browser can resolve it (it cannot
# for default Compose service names).
NEXT_PUBLIC_KNOWLEDGE_STORE_URL=

# Optional WebSocket base for MAS chat. Must be reachable from the browser.
# If unset, the client uses ws(s)://<same host as the page>:8000. Never use
# ws://mas:8000 from a browser on your machine.
NEXT_PUBLIC_WS_URL=
