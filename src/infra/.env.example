# ============================================================================
# HORUS MULTI-AGENT SYSTEM - INFRASTRUCTURE CONFIGURATION
# ============================================================================
# This .env.example file documents all environment variables required for
# the Horus infrastructure (Docker Compose stack).
#
# SETUP INSTRUCTIONS:
# 1. Easiest — from the repository root (creates src/infra/.env if missing, then compose up --build):
#      chmod +x stack-up.sh && ./stack-up.sh -d
#    GPU: default docker-compose.yml requests NVIDIA GPUs for mas, agent, knowledge_store (see README if you need CPU-only).
#    Or step by step: bash init-env.sh  then  docker compose up --build -d
#    Or manually: cp .env.example .env  then set JWT_SECRET_KEY (e.g. openssl rand -hex 32)
# 2. Update other values for your local/production settings
# 3. NEVER commit .env to version control (only .env.example)
# 4. Keep .env in .gitignore
#
# SECURITY NOTE:
# All sensitive values (passwords, secrets, API keys) should be:
# - Changed from defaults in production
# - Stored securely using a secrets management system
# - Never logged or exposed in debug output
# ============================================================================

# ============================================================================
# MESSAGE QUEUE - RABBITMQ
# ============================================================================
# RabbitMQ is used for asynchronous task distribution between agents

# Hostname/IP where RabbitMQ is accessible
# - Docker: "rabbitmq" (internal Docker hostname)
# - Local: "localhost"
RABBITMQ_HOST=rabbitmq

# Host port mapped to RabbitMQ AMQP (container always listens on 5672).
# Docker Compose pins MAS/agents to broker port 5672 on the internal network.
RABBITMQ_PORT=5672

# Default RabbitMQ user for authentication
RABBITMQ_USER=guest

# Default RabbitMQ password for authentication
# IMPORTANT: Change in production!
RABBITMQ_PASSWORD=guest


# ============================================================================
# DATABASE - POSTGRESQL
# ============================================================================
# PostgreSQL is the primary database for storing system state

# PostgreSQL database username
# - Used for: Authentication, schema ownership
POSTGRES_USER=postgres

# PostgreSQL database password
# IMPORTANT: Use strong password in production!
# - Minimum 12 characters
# - Mix of uppercase, lowercase, numbers, special characters
# - Never use default values in production
POSTGRES_PASSWORD=postgres

# PostgreSQL database name to create
# - Stores all MAS application data
POSTGRES_DB=mas_db

# Host port mapped to PostgreSQL (container listens on 5432).
# MAS uses 5432 on the Docker network regardless of this value.
DB_PORT=5432

# PostgreSQL hostname (inside Docker network)
# - Docker: "postgres" (service name)
# - Local: "localhost"
DB_HOST=postgres


# ============================================================================
# CACHE - REDIS
# ============================================================================
# Redis is used for session storage and caching

# Redis hostname
# - Docker: "redis" (service name)
# - Local: "localhost"
REDIS_HOST=redis

# Host port mapped to Redis (container listens on 6379).
# MAS uses 6379 on the Docker network regardless of this value.
REDIS_PORT=6379

# Redis password for authentication
# IMPORTANT: Change in production!
# - Minimum 16 characters for production
REDIS_PASSWORD=redis_password


# ============================================================================
# MAS (MULTI-AGENT SYSTEM) - AUTHENTICATION & SECURITY
# ============================================================================

# Initial admin user for MAS
# Created automatically on first startup
SUPER_USER_USERNAME=admin

# Initial admin password
# IMPORTANT: Change immediately after first login!
SUPER_USER_PASSWORD=admin

# JWT Secret Key for token signing (MAS only)
# init-env.sh overwrites this line when you create .env; if you copy by hand, run:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace-by-running-init-env-sh

# JWT algorithm used for token signing
# Options: HS256 (HMAC-SHA256), RS256 (RSA), etc.
JWT_ALGORITHM=HS256

# Alignment: only MAS reads JWT_* to sign tokens. The web UI and agent obtain tokens
# from MAS via /auth/token — no second secret. After changing JWT_SECRET_KEY, restart
# `mas` and `agent`, then sign in again in the browser (new localStorage token).


# ============================================================================
# MAS - TASK RUNTIME
# ============================================================================
# Maximum seconds a task may stay RUNNING before MAS cancels it (orchestrator + agent + LLM).
# Too low (e.g. 120) cancels slow CPU/GPU inference and leaves chat stuck on "loading" until refresh.
# TASK_TIMEOUT_SECONDS is an alias read by MAS as well.
TASK_TIMEOUT=1800


# ============================================================================
# MAS - LLM CONFIGURATION
# ============================================================================

# Auto-initialize the orchestrator LLM (Qwen) when the MAS process starts.
# - 0: Skip load (e.g. unit tests)
# - 1: Preload in a background thread after RabbitMQ connects (weights should already be in the image; see DOWNLOAD_LLM)
LLM_AUTOINIT=1

# 0 = use NVIDIA GPU for the orchestrator LLM when the mas container has CUDA (compose sets gpus: all on mas).
# 1 = force CPU (e.g. no GPU for MAS or saving VRAM for other services).
LLM_FORCE_CPU=0

# Optional: cap VRAM for the orchestrator / agent 4-bit load (Accelerate max_memory). Leave unset to use all GPU memory.
# LLM_GPU_MEMORY_CAP=6GiB
# LLM_CPU_OFFLOAD_CAP=16GiB

# CPU-only inference: PyTorch intra-op threads (default caps at 8). Raise on many-core hosts.
# LLM_TORCH_INTRAOP_THREADS=8
# AGENT_TORCH_INTRAOP_THREADS=8

# --- Offline / air-gapped runtime (defaults match Dockerfiles) ---
# DOWNLOAD_LLM=1  → `docker compose build` downloads Qwen into the mas + agent images (needs internet at build time only).
# Set DOWNLOAD_LLM=0 only for air-gapped builds if you inject models another way.
# HF_HUB_OFFLINE=1 and TRANSFORMERS_OFFLINE=1 → block Hugging Face at runtime (Compose passes these into mas, agent, knowledge_store).
# To pull new weights at runtime instead, set both to 0 and rebuild without embedding.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
DOWNLOAD_LLM=1


# ============================================================================
# AGENT SERVICE (Docker Compose passes these into the agent container)
# ============================================================================
# Agent decision LLM (same default as MAS: Qwen3 4B instruct). Hub id or use local files under app/models/Qwen3_instruct_4B/.
# MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Device: auto | cpu | cuda — Compose default is auto (NVIDIA + PyTorch CUDA in container).
# Optional: force CPU for the agent LLM only (MAS can still use GPU if configured).
# AGENT_FORCE_CPU=1
# Max new tokens per decide() call (RAG / ReAct / writer).
# AGENT_MAX_NEW_TOKENS=256
# 0 = load decision LLM at agent startup (default in docker-compose). 1 = load on first chat (faster boot, slower first reply).
# AGENT_LAZY_DECISION_MODEL=0
# MODEL_DEVICE=auto
#
# Knowledge store HTTP base (Compose: KNOWLEDGE_STORE_URL=http://knowledge_store:8080).
# Optional path prefix only if a reverse proxy mounts the API under a subpath (default: empty).
# KNOWLEDGE_STORE_API_PREFIX=
# Same prefix for the browser-built web client (requires web-client image rebuild).
# NEXT_PUBLIC_KNOWLEDGE_STORE_API_PREFIX=

# ============================================================================
# PGADMIN - DATABASE ADMINISTRATION
# ============================================================================
# PgAdmin is a web UI for PostgreSQL database management
# Access: http://localhost:5433

# Email for PgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@admin.com

# Password for PgAdmin login
# IMPORTANT: Change in production!
PGADMIN_DEFAULT_PASSWORD=admin


# ============================================================================
# WEB CLIENT + BROWSER (DOCKER BETA) — COMMON MISTAKE TO AVOID
# ============================================================================
# Compose service names (mas, postgres, rabbitmq, redis, agent, …) resolve
# only on the Docker internal network. Your browser on the host does NOT use
# that DNS.
#
# Therefore:
# - Do NOT put http://mas:8000 (or any service name) in NEXT_PUBLIC_* vars for
#   the web-client. Those values are embedded in frontend JS and will fail in
#   the browser with net::ERR_NAME_NOT_RESOLVED.
# - The web-client image/Compose sets ORCHESTRATOR_URL=http://mas:8000 on
#   purpose for Next.js *server-side* proxying to MAS; that is correct and is
#   not the same as a browser calling mas directly.
# - For local overrides, see ../services/web-client/.env.local.example.
# ============================================================================


# ============================================================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================================================

# Metabase is available on http://localhost:5434
# (Pre-configured data source: PostgreSQL on "postgres" service)

# RedisInsight available on http://localhost:5540
# (Pre-configured connection to Redis on "redis" service)

# Prometheus metrics: http://localhost:9090
# PostgreSQL exporter metrics: http://localhost:9187
# Grafana dashboards: http://localhost:3001