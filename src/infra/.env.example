# ============================================================================
# HORUS MULTI-AGENT SYSTEM - INFRASTRUCTURE CONFIGURATION
# ============================================================================
# This .env.example file documents all environment variables required for
# the Horus infrastructure (Docker Compose stack).
#
# SETUP INSTRUCTIONS:
# 1. Easiest — from the top of this folder (creates src/infra/.env if missing, then compose up --build):
#      chmod +x stack-up.sh && ./stack-up.sh -d
#    GPU: default docker-compose.yml requests NVIDIA GPUs for four services — mas, agent, vllm, knowledge_store (see README if you need CPU-only).
#    Or step by step: bash init-env.sh  then  docker compose up --build -d
#    Or manually: cp .env.example .env  then set JWT_SECRET_KEY and REDIS_PASSWORD (e.g. openssl rand -hex 32 for each)
# 2. Update other values for your local/production settings
# 3. NEVER commit .env to version control (only .env.example)
# 4. Keep .env in .gitignore
#
# SECURITY NOTE:
# All sensitive values (passwords, secrets, API keys) should be:
# - Changed from defaults in production
# - Stored securely using a secrets management system
# - Never logged or exposed in debug output
# ============================================================================

HORUS_VERSION=0.1.2
# HORUS_REGISTRY=ghcr.io/epitechpromo2027

# ============================================================================
# MESSAGE QUEUE - RABBITMQ
# ============================================================================
# RabbitMQ is used for asynchronous task distribution between agents

# Hostname/IP where RabbitMQ is accessible
# - Docker: "rabbitmq" (internal Docker hostname)
# - Local: "localhost"
RABBITMQ_HOST=rabbitmq

# Host port mapped to RabbitMQ AMQP (container always listens on 5672).
# Docker Compose pins MAS/agents to broker port 5672 on the internal network.
RABBITMQ_PORT=5672

# Default RabbitMQ user for authentication
RABBITMQ_USER=guest

# Default RabbitMQ password for authentication
# IMPORTANT: Change in production!
RABBITMQ_PASSWORD=guest


# ============================================================================
# COMPOSE PROJECT
# ============================================================================
# Names the containers, volumes and network. Without it Compose uses the name
# of the folder this file sits in - always "infra" - so two Horus installs on
# one machine silently share one database and one set of volumes. The second
# install then fails with "password authentication failed", because Postgres
# keeps the credentials of whichever install created the volume first.
COMPOSE_PROJECT_NAME=horus_betatest


# ============================================================================
# WEB CLIENT - NETWORK ACCESS
# ============================================================================
# Address the web client (port 3000) listens on. 127.0.0.1, the default, keeps
# Horus on this machine, like every other port. Set 0.0.0.0 to open the web
# client to the network on purpose: other machines then reach its sign-in page
# and, through it, the MAS API, but chat and the knowledge store do not work
# from them yet (docs/security.md, section 6.3). Use 127.0.0.1 or 0.0.0.0: with
# any other address http://localhost:3000 stops working on this machine.
# START-HERE --start (or docker compose up -d) applies a change.
HORUS_WEB_BIND=127.0.0.1


# ============================================================================
# DATABASE - POSTGRESQL
# ============================================================================
# PostgreSQL is the primary database for storing system state

# PostgreSQL database username
# - Used for: Authentication, schema ownership
POSTGRES_USER=postgres

# PostgreSQL database password
# IMPORTANT: Use strong password in production!
# - Minimum 12 characters
# - Mix of uppercase, lowercase, numbers, special characters
# - Never use default values in production
POSTGRES_PASSWORD=postgres

# PostgreSQL database name to create
# - Stores all MAS application data
POSTGRES_DB=mas_db

# Host port mapped to PostgreSQL (container listens on 5432).
# MAS uses 5432 on the Docker network regardless of this value.
DB_PORT=5432

# PostgreSQL hostname (inside Docker network)
# - Docker: "postgres" (service name)
# - Local: "localhost"
DB_HOST=postgres


# ============================================================================
# CACHE - VALKEY (the `redis` service)
# ============================================================================
# Valkey holds sessions, task events and the agent's response cache

# Valkey hostname
# - Docker: "redis" (service name)
# - Local: "127.0.0.1"
REDIS_HOST=redis

# Port Valkey is published on, on 127.0.0.1 only (container listens on 6379).
# MAS uses 6379 on the Docker network regardless of this value.
REDIS_PORT=6379

# Valkey password. Empty here on purpose: init-env.sh and the installer write a
# random one. If you copy this file by hand, set one (openssl rand -hex 32):
# with an empty password Valkey refuses every other container and the redis
# healthcheck fails.
REDIS_PASSWORD=


# ============================================================================
# MAS (MULTI-AGENT SYSTEM) - AUTHENTICATION & SECURITY
# ============================================================================

# Initial admin user for MAS
# Created automatically on first startup
SUPER_USER_USERNAME=admin

# Initial admin password. Empty here on purpose: init-env.sh and the installer
# write a random one, and the installer shows it once, at the end. If you copy
# this file by hand, set one (openssl rand -hex 16): MAS refuses to create the
# admin account with an empty password or "admin". An older install whose
# account still has "admin" gets this password the next time MAS starts; an
# account whose password was changed in Horus keeps it. The agent signs in
# with this value, so keep it equal to the admin account's password.
SUPER_USER_PASSWORD=

# JWT Secret Key for token signing (MAS only)
# init-env.sh overwrites this line when you create .env; if you copy by hand, run:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace-by-running-init-env-sh

# JWT algorithm used for token signing
# Options: HS256 (HMAC-SHA256), RS256 (RSA), etc.
JWT_ALGORITHM=HS256

# Alignment: only MAS reads JWT_* to sign tokens. The web UI and agent obtain tokens
# from MAS via /auth/token — no second secret. After changing JWT_SECRET_KEY, restart
# `mas` and `agent`, then sign in again in the browser (new localStorage token).


# ============================================================================
# MAS - TASK RUNTIME
# ============================================================================
# Maximum seconds a task may stay RUNNING before MAS cancels it (orchestrator + agent + LLM).
# Too low (e.g. 120) cancels slow CPU/GPU inference and leaves chat stuck on "loading" until refresh.
# TASK_TIMEOUT_SECONDS is an alias read by MAS as well.
TASK_TIMEOUT=1800

# Seconds the agent's RAG pipeline waits for ONE decide() call before giving up.
# This is the timeout that actually binds a chat answer - NOT TASK_TIMEOUT above.
# Code default is 120 (src/services/agent/app/ai_agents/rag_pipeline.py). On expiry
# the user gets "The model took too long to respond." as a COMPLETED task, not an
# error, so a value that is too low looks like a bad answer rather than a timeout.
# GPU: 120-600 is fine. CPU-only: needs to be far higher - see LLM_BACKEND below.
# REACT_TIMEOUT_SECONDS=120


# ============================================================================
# MAS - LLM CONFIGURATION
# ============================================================================

# Auto-initialize the orchestrator LLM (Qwen) when the MAS process starts.
# - 0: Skip load (e.g. unit tests)
# - 1: Preload in a background thread after RabbitMQ connects (weights should already be in the image; see DOWNLOAD_LLM)
LLM_AUTOINIT=1

# 0 = use NVIDIA GPU for the orchestrator LLM when the mas container has CUDA (compose sets gpus: all on mas).
# 1 = force CPU (e.g. no GPU for MAS or saving VRAM for other services).
LLM_FORCE_CPU=0

# Optional: cap VRAM for the orchestrator / agent 4-bit load (Accelerate max_memory). Leave unset to use all GPU memory.
# LLM_GPU_MEMORY_CAP=6GiB
# LLM_CPU_OFFLOAD_CAP=16GiB

# CPU-only inference: PyTorch intra-op threads (default caps at 8). Raise on many-core hosts.
# LLM_TORCH_INTRAOP_THREADS=8
# AGENT_TORCH_INTRAOP_THREADS=8

# --- Offline / air-gapped runtime ---
# The 4B model is NOT baked into the images. It downloads on first container
# start into the `mas_model_cache` and `agent_model_cache` named volumes and
# persists across rebuilds, so a rebuild does not re-download it. The images
# are still about 11 GB each: that is the PyTorch/CUDA stack, not weights.
#
# Defaults below let the first run pull from Hugging Face. Flip both to 1
# once the cache volumes are populated to enforce air-gapped mode.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Hugging Face token (Read scope). Raises Hub rate limits so the first-run model
# pull is faster and less likely to be throttled. Empty = anonymous downloads.
# Consumed by docker-compose.yml as ${HF_TOKEN:-}. NEVER commit a real token.
HF_TOKEN=

# --- Tiered model defaults (per-service) ---
# MAS is a thin router/classifier: it picks an agent and optionally decomposes
# a task into subtasks. Light work → small model. Default: Qwen2.5-1.5B (~3 GB).
#
# The agent worker is where the real reasoning happens: RAG synthesis, final
# answer generation, multi-step task execution. Heavy work → bigger model.
# Default: Qwen3-4B-Instruct-2507 (~8 GB).
#
# Override either independently below. Set them to the same id to fall back
# to the old "one model everywhere" behaviour.
# LLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct


# ============================================================================
# LLM BACKEND SELECTION (MAS + agent)
# ============================================================================
# Which inference engine both services use for generation:
#   vllm         - call an OpenAI-compatible server: the `vllm` container on a
#                  GPU, the `llm` llama-server container of docker-compose.cpu.yml
#                  on a CPU (LLM_VLLM_URL=http://llm:8080/v1). This is what the
#                  stack ships with.
#   transformers - load the model in-process via HuggingFace. Works on CPU.
# Read by src/services/mas/core/llm_setup.py and
# src/services/agent/app/ai_agents/decision_making_agent.py (both default to
# "transformers" when this variable is absent).
#
# THERE IS NO AUTOMATIC FALLBACK. With LLM_BACKEND=vllm and the vllm container
# down, the MAS router raises straight out of POST /tasks/new_task and chat
# returns HTTP 500. If you have no NVIDIA GPU, add the CPU overlay, point
# LLM_VLLM_URL at http://llm:8080/v1 and raise REACT_TIMEOUT_SECONDS well above
# its default.
LLM_BACKEND=vllm

# Where the vLLM server lives. Compose runs it as the `vllm` service, so the
# in-network URL is http://vllm:8000/v1. (The code default is
# http://host.docker.internal:18000/v1, i.e. a vLLM running on the host instead.)
LLM_VLLM_URL=http://vllm:8000/v1

# Must match --served-model-name in the vllm service (VLLM_SERVED_MODEL_NAME below).
LLM_VLLM_MODEL=qwen3-4b

# Seconds MAS waits on a vLLM HTTP call before giving up (code default 120).
# LLM_VLLM_TIMEOUT=120


# ============================================================================
# MOCK AI MODE (docs/mock-ai.md, ADR-008)
# ============================================================================
# local - the AI models of this machine's profile: the language model
#         (llama-server `llm` on a CPU, vLLM on a GPU), FastEmbed's MiniLM and
#         bge-base embeddings, and spaCy. The default.
# mock  - no AI model at all: the `llm-mock` server answers every model call
#         with text taken from your documents and their sources, or says it
#         does not have the information, and it computes the embeddings from
#         the words of each text, so search is word matching. spaCy is off,
#         and so is monitoring unless HORUS_MONITORING=on. The answers and the
#         search are SIMULATED. Sign-in, tasks and the rest of Horus are real.
# The switch is COMPOSE_FILE: mock mode adds docker-compose.mock.yml after
# docker-compose.cpu.yml, then docker-compose.monitoring-off.yml. The installer
# changes them together and re-embeds the stored documents:
#   START-HERE --ai mock | --ai local | --ai status
HORUS_AI_MODE=local

# on | off: Prometheus, Loki, Tempo and Alloy, and the traces the services send
# them. Unset, monitoring is off in mock mode and on in local mode. The
# installer applies a change on the next --start or --restart.
# HORUS_MONITORING=

# Set by docker-compose.mock.yml in mock mode; a local install may use them too.
# An OpenAI-compatible embeddings server (POST <url>/embeddings) for MAS, which
# needs 384 values per vector, and for the knowledge store, which needs 768.
# Unset, FastEmbed runs the model inside the service. Setting or clearing the
# knowledge store's URL, or naming another model, re-embeds the stored
# documents at the next start; a new URL for the same model does not.
# MAS_EMBED_URL=
# MAS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# KNOWLEDGE_STORE_EMBED_URL=
# KNOWLEDGE_STORE_EMBED_MODEL=BAAI/bge-base-en-v1.5
# off turns spaCy off in the knowledge store and the agent: entities, topics
# and summaries then come from regular expressions.
# HORUS_SPACY=on

# llm-mock's settings (read only in mock mode):
# Milliseconds it waits before each answer (0 makes CI faster).
# HORUS_MOCK_LATENCY_MS=300
# normal | slow (5-40 s per call) | invalid_json (broken JSON) |
# refuse (every answer is the refusal) | error (every model call fails)
# HORUS_MOCK_SCENARIO=normal
# Below this score a sentence is not an answer and the agent gets the refusal
# "I don't have that information yet." (0 to 1).
# HORUS_MOCK_MIN_SCORE=0.2


# ============================================================================
# vLLM SERVER (the `vllm` Compose service)
# ============================================================================
# These feed docker-compose.yml directly. Every default shown is the value the
# stack already shipped with, so leaving them commented changes nothing.
# Tuned for an 8 GB laptop GPU; raise the length/utilisation on a larger card.
# VLLM_IMAGE=vllm/vllm-openai:v0.23.0
# VLLM_MODEL=warshanks/Qwen3-4B-Instruct-2507-AWQ
# VLLM_SERVED_MODEL_NAME=qwen3-4b          # keep in sync with LLM_VLLM_MODEL
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_MEMORY_UTILIZATION=0.70
# VLLM_SHM_SIZE=4gb
# VLLM_HOST_PORT=18000
# VLLM_HC_RETRIES=40
# VLLM_HC_START_PERIOD=300s

# Memory ceilings for the mas container (Compose mem_limit / memswap_limit).
# MAS_MEM_LIMIT=14g
# MAS_MEMSWAP_LIMIT=14g


# ============================================================================
# AGENT SERVICE (Docker Compose passes these into the agent container)
# ============================================================================
# Agent decision LLM. Default Qwen3-4B-Instruct (heavy reasoning). Drop to
# the 1.5B variant if you want a lighter setup at the cost of answer quality.
# MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
# Device: auto | cpu | cuda — Compose default is auto (NVIDIA + PyTorch CUDA in container).
# Optional: force CPU for the agent LLM only (MAS can still use GPU if configured).
# AGENT_FORCE_CPU=1
# Max new tokens per decide() call (RAG / ReAct / writer).
# AGENT_MAX_NEW_TOKENS=256
# Early-stop the self-correction spiral mid-generation (default ON). When the 4B
# worker loops on ambiguous retrieved numbers it otherwise decodes to
# AGENT_MAX_NEW_TOKENS (~3072 tok / ~150s) before the post-hoc guard discards it;
# the early-stop cuts that to a few hundred tokens with identical visible output.
# Set to 0 only to A/B or debug the raw spiral.
# AGENT_EARLY_STOP=1
# Phase 1 token streaming: stream confirmed-clean tokens to the chat UI live as
# reasoning.delta steps (over the existing step->WebSocket path; no new infra).
# "Hold a beat" buffers ~125 tokens and runs the spiral guard before streaming
# so the user never sees self-correction garbage. Default OFF (blocking).
# AGENT_STREAM_TOKENS=1
# Phase 3 response cache (Redis): caches answers keyed on query + retrieved
# context + gen params. Safe across users/versions (different retrieval => diff
# key); a hit skips generation. Default OFF. TTL via AGENT_RESPONSE_CACHE_TTL (s).
# AGENT_RESPONSE_CACHE=1
# AGENT_RESPONSE_CACHE_TTL=3600
# 0 = load decision LLM at agent startup (default in docker-compose). 1 = load on first chat (faster boot, slower first reply).
# AGENT_LAZY_DECISION_MODEL=0
# MODEL_DEVICE=auto
#
# Knowledge store HTTP base (Compose: KNOWLEDGE_STORE_URL=http://knowledge_store:8080).
# Optional path prefix only if a reverse proxy mounts the API under a subpath (default: empty).
# KNOWLEDGE_STORE_API_PREFIX=
# Same prefix for the browser-built web client (requires web-client image rebuild).
# NEXT_PUBLIC_KNOWLEDGE_STORE_API_PREFIX=
#
# BGE embedder device: auto | cpu | cuda. The images ship the CPU onnxruntime, so all three embed on the CPU.
# On the 8 GB laptop GPU, set cpu to keep the BGE embedder OFF the shared card so
# its embedding bursts stop paging out the agent's 4B model (the contention /
# post-ingest stalls measured by scripts/perf/benchmark-pipeline.py). Trades a
# little query-embed latency for stable generation. Requires a knowledge_store
# image rebuild to take effect (code is baked in, not bind-mounted).
# KNOWLEDGE_STORE_EMBED_DEVICE=auto

# Chunks the knowledge store returns per retrieval. Raising 4 -> 10 measurably
# reduced confabulation on the demo corpus (the model stopped inventing figures).
# KNOWLEDGE_STORE_N_RESULTS=10

# Threads the BGE embedder may use; empty lets onnxruntime choose.
# KNOWLEDGE_STORE_EMBED_THREADS=

# 1 re-indexes at start-up the documents stored whole or with another embedder; 0 only logs them.
# KNOWLEDGE_STORE_REINDEX_ON_STARTUP=1

# Optional VRAM / offload ceilings for the agent's own model load (Accelerate).
# AGENT_GPU_MEMORY_CAP=4GiB
# AGENT_CPU_OFFLOAD_CAP=24GiB

# ============================================================================
# OBSERVABILITY - OPENTELEMETRY
# ============================================================================
# Tracing is on by default, and Tempo runs unless monitoring is off
# (HORUS_MONITORING, above), which also turns tracing off. docker-compose.yml
# reads these as ${OTEL_SDK_DISABLED:-false} / ${OTEL_ENABLED:-true}.
# Set OTEL_SDK_DISABLED=true and OTEL_ENABLED=false to opt out.
OTEL_SDK_DISABLED=false
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317


# ============================================================================
# OBSERVABILITY - CONTAINER LOGS
# ============================================================================
# Docker keeps each container's output in at most HORUS_LOG_MAX_FILE files of
# HORUS_LOG_MAX_SIZE each and deletes the oldest file. The defaults keep about
# 400 MB per container: 3 to 7 days of MAS, the chattiest service, but under
# an hour when MAS logs a traceback on every request (about 500 MB in one
# hour on 2026-09-09). A change applies to the containers that
# `docker compose up -d` creates after it.
# HORUS_LOG_MAX_SIZE=40m
# HORUS_LOG_MAX_FILE=10


# ============================================================================
# BUILD / TEST TOGGLES
# ============================================================================
# The service Dockerfiles use BuildKit pip cache mounts. Modern Docker enables
# BuildKit by default; set 0 only if you must use the legacy builder.
# DOCKER_BUILDKIT=1

# 1 puts MAS in test mode (skips parts of startup). Keep 0 for a normal stack.
TEST_MODE=0


# ============================================================================
# PGADMIN - DATABASE ADMINISTRATION
# ============================================================================
# PgAdmin is a web UI for PostgreSQL database management, a development tool
# Access: http://localhost:5433, only with: docker compose --profile dev-tools up

# Email for PgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@admin.com

# Password for PgAdmin login
# IMPORTANT: Change in production!
PGADMIN_DEFAULT_PASSWORD=admin


# ============================================================================
# WEB CLIENT + BROWSER (DOCKER BETA) — COMMON MISTAKE TO AVOID
# ============================================================================
# Compose service names (mas, postgres, rabbitmq, redis, agent, …) resolve
# only on the Docker internal network. Your browser on the host does NOT use
# that DNS.
#
# Therefore:
# - Do NOT put http://mas:8000 (or any service name) in NEXT_PUBLIC_* vars for
#   the web-client. Those values are embedded in frontend JS and will fail in
#   the browser with net::ERR_NAME_NOT_RESOLVED.
# - The web-client image/Compose sets ORCHESTRATOR_URL=http://mas:8000 on
#   purpose for Next.js *server-side* proxying to MAS; that is correct and is
#   not the same as a browser calling mas directly.
# - For local overrides, see ../services/web-client/.env.local.example.
# ============================================================================


# ============================================================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================================================

# Observability (logs, metrics, traces) is viewed in the web client's admin pages:
#   http://localhost:3000/admin/logs      (Loki)
#   http://localhost:3000/admin/metrics   (Prometheus)
#   http://localhost:3000/admin/traces    (Tempo)
# The backends run inside the Docker network and are not published to the host by
# default (Prometheus :9090, Loki :3100, Tempo :3200 are internal-only).