# =============================================================================
# Database / auth / queues — preserved from your existing setup.
# =============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=orchestrator_db
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=secret
# Host-side tools only: docker-compose overrides DB_HOST/REDIS_HOST/RABBITMQ_HOST for the `mas` container.
DB_HOST=localhost
DB_PORT=5432
SUPER_USER_USERNAME=admin
SUPER_USER_PASSWORD=secret
# MAS signs every /auth/token response with this. If you change it: restart mas + agent
# and clear site data in the browser. Generate a strong one: openssl rand -hex 32
JWT_SECRET_KEY=5ffd1ba3ec16e2f2712968dbb0fe628b505fbe75fbb99be8fcefbd05f28f9e95
JWT_ALGORITHM=HS256
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_HOST=localhost
RABBITMQ_HOST=localhost
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672

# =============================================================================
# Misc.
# =============================================================================
TASK_TIMEOUT=1800
DOCKER_BUILDKIT=0
TEST_MODE=0

# =============================================================================
# Hugging Face / model download (NEW behaviour).
# =============================================================================
# Models are no longer baked into images. They download on first container
# start into the `mas_model_cache` / `agent_model_cache` named volumes.
# Keep these at 0 for the first run so the bootstrap script can pull from HF.
# Flip both to 1 after the caches are warm to enforce air-gapped mode.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# =============================================================================
# MAS orchestrator LLM (tiered with the agent).
# =============================================================================
# MAS only routes/decomposes, so the small Qwen is enough on paper — but the
# 1.5B over-classifies simple tasks as COMPLEX, which the parser then can't
# digest reliably. Bumping back to the 4B fixes the FAILED TO PARSE PLAN JSON
# errors. Drop back to Qwen2.5-1.5B-Instruct only if VRAM is tight AND you've
# verified routing quality is acceptable for your prompts.
LLM_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
LLM_AUTOINIT=1
# 0 = use GPU when visible; 1 = force CPU
LLM_FORCE_CPU=0
# VRAM split for a single 8 GB card running MAS + agent — cap each at 4 GiB
# and let the rest spill to CPU. Comment out on a beefier GPU.
LLM_GPU_MEMORY_CAP=4GiB
LLM_CPU_OFFLOAD_CAP=24GiB

# =============================================================================
# Agent worker (the heavy lifter — RAG + answer generation).
# =============================================================================
# Default is Qwen3-4B-Instruct (compose default). Override here if needed.
# MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
AGENT_MAX_NEW_TOKENS=3072
# Retrieval breadth. Trimming to 4 (Phase 2) gave no TTFT win AND starved
# multi-part queries of grounding chunks → the model confabulated policy
# specifics. Back up to 10 so each sub-question has its source chunk in context.
KNOWLEDGE_STORE_N_RESULTS=10
# Spiral early-stop: halt the self-correction loop before it decodes to the
# token cap (~3072 tok / ~150s). Default ON in code; set 0 to A/B or debug.
AGENT_EARLY_STOP=1
# Phase 1 token streaming: stream confirmed-clean tokens to the chat UI as they
# decode (reasoning.delta over the existing step→WebSocket path). Hold-a-beat
# buffers ~125 tokens and runs the spiral guard first, so no garbage is shown.
AGENT_STREAM_TOKENS=1
# Phase 3 exact-match response cache (Redis). Key = query + retrieved context +
# gen params, so a hit is safe across users/document-versions and skips the
# costly generation on repeats. AGENT_RESPONSE_CACHE_TTL defaults to 3600s.
AGENT_RESPONSE_CACHE=1
# Phase 4 serving-engine swap. LLM_BACKEND=vllm makes the agent call an external
# vLLM OpenAI server (in WSL) instead of loading the 4B in-process — ~3x decode
# and continuous batching. The agent skips its local model load entirely.
# Set LLM_BACKEND=transformers to fall back to the in-process path.
LLM_BACKEND=vllm
# vLLM now runs as the in-stack `vllm` Compose service (internal network).
LLM_VLLM_URL=http://vllm:8000/v1
LLM_VLLM_MODEL=qwen3-4b
# Co-hosting on 8GB: vLLM(4B)+router(1.5B)+BGE don't all fit, so run the MAS
# router on CPU (read by mas/core/llm_setup.py). BGE stays on GPU.
LLM_FORCE_CPU=1
# Hard cap on a single ``decide()`` invocation (in ``RAGPipeline.generate_response``
# and the ReAct loop). With the 3072-token cap a long Markdown answer on CPU /
# 4-bit GPU can take 3-5 minutes; bumped from the 120s default to 600s so
# specialist-routed tasks (with long personas) don't trip the timeout.
REACT_TIMEOUT_SECONDS=600
AGENT_GPU_MEMORY_CAP=4GiB
AGENT_CPU_OFFLOAD_CAP=24GiB
# 0 = load LLM at startup (ready for first chat); 1 = lazy (faster boot, slower first reply)
AGENT_LAZY_DECISION_MODEL=0

# Multi-profile mode: the worker registers as 5 named agents by default
# (General-Assistant, Finance-Analyst, Compliance-Officer, Document-Writer,
# Researcher). Set AGENT_NAME below to instead run as a single specialised
# identity, or AGENT_PROFILES_JSON for a fully custom lineup.
# AGENT_NAME=
# AGENT_TYPE=general
# AGENT_SKILLS=knowledge_retrieval,decision_making,rag_pipeline
# AGENT_DESCRIPTION=

# =============================================================================
# Observability (always-on).
# =============================================================================
# Tempo is always-on in this stack, so OTEL is enabled by default.
# Set OTEL_SDK_DISABLED=true and OTEL_ENABLED=false to opt out.
OTEL_SDK_DISABLED=false
OTEL_ENABLED=true
# Compose injects this into mas/agent/knowledge_store.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PORT=4317
# BGE embedder device. "auto" = GPU when available (the good config). An
# Experiment-1 benchmark showed pinning to "cpu" is net-NEGATIVE on the 8 GB
# laptop GPU (it steals CPU cycles the generation path needs under ingestion
# load), so it was reverted to auto. Do not re-pin to cpu — see scripts/perf.
KNOWLEDGE_STORE_EMBED_DEVICE=auto
