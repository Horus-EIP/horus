# --- JWT (MAS only; must match the running MAS container) ---
# MAS signs every /auth/token response with JWT_SECRET_KEY + JWT_ALGORITHM.
# If you change JWT_SECRET_KEY: restart `mas` + `agent`, then log in again in the UI
# (clear site data or use a fresh browser session) so localStorage gets a new token.
# Generate a strong secret: openssl rand -hex 32
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=orchestrator_db
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=secret
# Host-side tools only: docker-compose overrides DB_HOST/REDIS_HOST/RABBITMQ_HOST for the `mas` container.
DB_HOST=localhost # postgres / localhost
DB_PORT=5432
SUPER_USER_USERNAME=admin
SUPER_USER_PASSWORD=secret
JWT_SECRET_KEY=5ffd1ba3ec16e2f2712968dbb0fe628b505fbe75fbb99be8fcefbd05f28f9e95
JWT_ALGORITHM=HS256
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_HOST=localhost # redis / localhost
LLM_AUTOINIT=1
RABBITMQ_HOST=localhost # rabbitmq / localhost
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672
# Stack uses Grafana Tempo (service `tempo`), not Jaeger. Compose sets this for mas/agent; keep aligned for any host-side OTEL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_PORT=4317
TASK_TIMEOUT=1800
DOCKER_BUILDKIT=0
TEST_MODE=0
LLM_FORCE_CPU=0
# --- Optional: GPU+CPU layer offload (Hugging Face Accelerate max_memory). Slower than full-GPU but fits when VRAM is tight.
# Uncomment and tune (example): part of Qwen stays on GPU, rest on CPU RAM — not the same engine as llama.cpp GGUF in share_cpu_gpu.md.
# RTX 4070 8GB: cap each model at 4GiB so MAS+Agent share the 8GB without OOM.
LLM_GPU_MEMORY_CAP=4GiB
LLM_CPU_OFFLOAD_CAP=24GiB
AGENT_GPU_MEMORY_CAP=4GiB
AGENT_CPU_OFFLOAD_CAP=24GiB
# Increase token budget so summarization responses aren't truncated.
AGENT_MAX_NEW_TOKENS=1024