server {
    listen 443 ssl;

    port_in_redirect off;
    absolute_redirect off;

    ssl_certificate /etc/nginx/certs/horus.crt;
    ssl_certificate_key /etc/nginx/certs/horus.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://${CLIENT_HOST}:${CLIENT_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws/ {
        access_log off;
        proxy_pass http://${MAS_HOST}:${MAS_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/knowledge/ {
        proxy_pass http://${KNOWLEDGE_HOST}:${KNOWLEDGE_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}